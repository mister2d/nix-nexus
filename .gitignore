# NixOS/Flake artifacts
result/
result-*
.direnv/
.nix-profile/
.nix-defexpr/

# Lock files
# flake.lock # Keep this if you want reproducible builds!

# User-specific
# .mcp.json and .claude/settings.json are generated by devenv's
# claude.code integration (modules/flake/checks.nix) as store symlinks.
.mcp.json
.claude/*
!.claude/agents/
!.claude/agents/*.md
!.claude/hooks/
!.claude/hooks/*.py
.env
.direnv/
debug/
plan/

# Host deployment values (real domains/addresses — never commit)
# hosts/avina/site-config.nix

# System specific
hardware-configuration.nix.bak
*.swp
*~

# Editor
.vscode/
.idea/
*.swp
*~
*.sync-conflict-*

# Ignore Gemini CLI environment settings to protect API keys
.gemini/settings.json
